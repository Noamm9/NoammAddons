{
  "schemaVersion": 1,
  "id": "noammaddons",
  "version": "${version}",
  "name": "NoammAddons",
  "description": "NoammAddons",
  "authors": [
    "Noamm"
  ],
  "contact": {
    "homepage": "https://github.com/Noamm9",
    "sources": "https://github.com/Noamm9/NoammAddons",
    "issues": "https://github.com/Noamm9/NoammAddons/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/noammaddons/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "com.github.noamm9.ui.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "value": "com.github.noamm9.NoammAddons",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "noammaddons.mixins.json"
  ],
  "accessWidener": "noammaddons.accesswidener",
  "depends": {
    //? if <26.2 {
    /*"fabricloader": ">=0.17.3",
    "minecraft": "26.1.2",*/
    //? } else if <26.3 {
    /*"fabricloader": ">=0.19.5",
    "minecraft": "26.2",*/
    //? } else {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    //? }
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Discord": "https://discord.com/invite/pj9mQGxMxB"
      }
    }
  }
}