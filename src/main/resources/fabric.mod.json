{
  "schemaVersion": 1,
  "name": "${mod_name}",
  "id": "${mod_id}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "authors": [
    "Noamm"
  ],
  "contact": {
    "homepage": "https://github.com/Noamm9",
    "sources": "https://github.com/Noamm9/NoammAddons",
    "issues": "https://github.com/Noamm9/NoammAddons/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "com.github.noamm9.ui.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "value": "com.github.noamm9.NoammAddons",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_version}",
    "fabric-language-kotlin": "*",
    "fabric-api": "*",
    "fabricloader": ">=${fabric_loader}"
  },
  "conflicts": {
    "${mod_id}": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Discord": "https://discord.com/invite/pj9mQGxMxB"
      }
    }
  }
}